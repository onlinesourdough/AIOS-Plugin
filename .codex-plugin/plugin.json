    "category": "Productivity",
    "capabilities": [
      "AIOS skills",
      "Browse context",
      "Open context files",
      "Check GitHub sync"
    ],
    "defaultPrompt": [
      "Open my AIOS overview.",
      "Set up AIOS for my current work."
    ],
    "websiteURL": "https://onlinesourdough.com/",
    "supportURL": "https://github.com/onlinesourdough/AIOS-Plugin/issues",
    "brandColorDark": "#f8f2e8",
    "composerIconDark": "./assets/icon.png",
    "logoDark": "./assets/icon.png"
  },
  "repository": "https://github.com/onlinesourdough/AIOS-Plugin",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/aios-setup/SKILL.md"
    }
  },
  "homepage": "https://onlinesourdough.com/",
  "mcpServers": "./.codex-plugin/mcp.json"
}
