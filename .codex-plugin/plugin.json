{
  "name": "aios",
  "version": "0.16.0",
  "description": "Portable context and skills for planning, design, content and reviewed delivery.",
  "author": {
    "name": "onlinesourdough"
  },
  "skills": "./skills/",
  "interface": {
    "displayName": "AIOS",
    "brandColor": "#2b1b12",
    "composerIcon": "./assets/icon.png",
